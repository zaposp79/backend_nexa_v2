      "notas": "Excel Condiciones Cadena B B47:K71. Fórmula K47=IFERROR((J47/I47)*(1+Panel!L11),0). Panel!L11=tasa mensual (1.53% en 006_ElTiempo).",
      "subformulas": {
        "mes_activo": "mes_inicio_item <= mes_t <= (mes_inicio_item + meses_diferir - 1)",
