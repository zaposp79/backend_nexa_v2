[
  {
    "id": "nomina_total_mensual",
    "version": "v2.8",
    "nombre": "Nómina Total Mensual Cadena A",
    "bloque": "Nómina",
    "capa": 1,
    "descripcion": "Suma del costo empresa de todos los perfiles (agentes + estructura) en Cadena A, aplicando reglas de Salario Integral, Aux Transporte y Dotaciones.",
    "orden_calculo": 10,
    "aplica_por_mes": true,
    "tipo_calculo": "aggregated",
    "formula": {
      "expresion": "sum(costo_empresa_perfil_i * fte_perfil_i for each perfil) + sum(costo_empresa_cargo_j * cantidad_cargo_j for each cargo_estructura)",
      "notas": "Cada perfil y cargo usa las subformulas de costo_empresa definidas abajo. Cantidad de cargo estructura = ceil(FTE_total_agentes / ratio_cargo_j).",
      "subformulas": {
        "t_imponible": "salario_base + comision_variable",
        "aux_transporte": "249095 if (0 < t_imponible < 2 * SMLV) else 0",
        "t_haberes": "t_imponible + aux_transporte",
        "base_integral": "t_haberes - aux_transporte",
        "es_integral": "base_integral > 10 * SMLV",
        "salud": "t_imponible * 0.70 * 0.085 if es_integral else 0",
        "pension": "base_integral * 0.12 * (0.70 if es_integral else 1)",
        "arl": "base_integral * 0.00522 * (0.70 if es_integral else 1)",
        "seg_social": "salud + pension + arl",
        "caja": "base_integral * 0.04 * (0.70 if es_integral else 1)",
        "icbf_sena": "t_imponible * 0.04 * 0.70 if es_integral else 0",
        "parafiscales": "caja + icbf_sena",
        "cesantias": "0 if es_integral else t_haberes * 0.0833",
        "primas": "0 if es_integral else t_haberes * 0.0833",
        "interes_cesantia": "cesantias * 0.12",
        "vacaciones": "base_integral * 0.0417 * (0.70 if es_integral else 1)",
        "prestaciones": "cesantias + primas + interes_cesantia + vacaciones",
        "dotaciones": "15375 if (0 < t_imponible < 2 * SMLV) else 0",
        "costo_empresa": "t_haberes + seg_social + parafiscales + prestaciones + dotaciones"
      }
    },
    "variables": [
      { "nombre": "SMLV", "tipo": "parametro", "fuente": "parametrization", "path": "hr.smlv_mensual", "valor_referencia": 1795000 },
      { "nombre": "salario_base", "tipo": "input", "fuente": "request.condiciones_cadena_a.detalle_nomina[*].salario" },
      { "nombre": "comision_variable", "tipo": "input", "fuente": "request.condiciones_cadena_a.detalle_nomina[*].comision" },
      { "nombre": "fte_perfil_i", "tipo": "input", "fuente": "request.condiciones_cadena_a.perfiles[*].fte" },
      { "nombre": "ratio_cargo_j", "tipo": "input", "fuente": "request.condiciones_cadena_a.ratios[*].ratio_por_perfil" },
      { "nombre": "ausentismo_pct", "tipo": "input", "fuente": "request.reglas_negocio.ausentismo", "valor_referencia": 0.065 },
      { "nombre": "rotacion_pct", "tipo": "input", "fuente": "request.reglas_negocio.rotacion", "valor_referencia": 0.085 }
    ],
    "dependencias": [],
    "cadena": "A"
  },

  {
    "id": "no_payroll_total_mensual",
    "version": "v2.8",
    "nombre": "No Payroll Total Mensual Cadena A",
    "bloque": "No Payroll",
    "capa": 2,
    "descripcion": "Suma de OPEX fijo (crucero × FTE), inversiones amortizadas y costos fijos adicionales del deal.",
    "orden_calculo": 20,
    "aplica_por_mes": true,
    "tipo_calculo": "aggregated",
    "formula": {
      "expresion": "opex_fijo + inversiones_mensual + costos_adicionales_mensual",
      "subformulas": {
        "opex_fijo": "crucero_valor * fte_total_cadena_a",
        "inversiones_mensual": "sum(inversion_i / meses_amortizacion_i for each inversion_i)",
        "costos_adicionales_mensual": "sum(item_costo_adicional for each item in inversiones_adicionales)"
      }
    },
    "variables": [
      { "nombre": "crucero_valor", "tipo": "input", "fuente": "request.reglas_negocio.crucero", "valor_referencia": 8600 },
      { "nombre": "fte_total_cadena_a", "tipo": "computed", "rubro_fuente": "fte_total_cadena_a" },
      { "nombre": "inversiones", "tipo": "input", "fuente": "request.condiciones_cadena_a.inversiones" },
      { "nombre": "meses_proyecto", "tipo": "input", "fuente": "request.datos_operativos.meses_contrato", "valor_referencia": 10 }
    ],
    "dependencias": [],
    "cadena": "A"
  },

  {
    "id": "costo_cadena_a",
