    "descripcion": "Costo mensual del equipo S&M: salarios cargados de perfiles activos + dispositivos asignados. Escalado con IPC humano y tecnológico respectivamente. Distribuido por canal según volumen.",
    "orden_calculo": 230,
    "aplica_por_mes": true,
    "tipo_calculo": "aggregated",
    "formula": {
      "expresion": "(gasto_personal_sm * ipc_hum(t) + opex_dispositivos_sm * ipc_tec(t)) * proporcion_canal",
      "notas": "Excel Costo Fijo filas 187-198 (personal) + filas 202-206 (dispositivos). Proporción canal = vol_canal / vol_total_inbound.",
      "subformulas": {
        "gasto_personal_sm": "sum(salario_loaded(perfil) * fte_sm(perfil) for perfil in perfiles_sm if perfil.activo)",
