  {
    "id": "ingreso_cadena_a",
    "version": "v2.8",
    "nombre": "Ingreso Cadena A (tarifa bruta)",
    "bloque": "P&G - Ingresos",
    "capa": 6,
    "descripcion": "Tarifa que se cobra al cliente para la Cadena A, calculada para cubrir costos + margen + ajustes comerciales.",
    "orden_calculo": 60,
    "aplica_por_mes": true,
    "tipo_calculo": "formula",
    "formula": {
      "expresion": "costo_cadena_a / ((1 - margen_a - tasa_financiero_efectiva) * (1 - cont_op) * (1 - cont_com) * (1 - markup) * (1 + descuento))",
      "notas": "Fuente: Hoja Maestra Escenarios. Excel V2-8: ingreso=costo/(1-margen-tasa_financiero_efectiva). tasa_financiero_efectiva=ica+gmf+polizas*(1-imprevistos): ICA/GMF aplican sobre ingreso_bruto (ley colombiana), pólizas sobre ingreso_neto. ramp_up NO aplica a ingreso_cadena_a. Para SAC cont_op=cont_com=markup=descuento=0."
    },
    "variables": [
      { "nombre": "costo_cadena_a", "tipo": "computed", "rubro_fuente": "costo_cadena_a" },
      { "nombre": "margen_a", "tipo": "input", "fuente": "request.reglas_negocio.margen_objetivo_cadena_a", "valor_referencia": 0.18 },
      { "nombre": "cont_op", "tipo": "input", "fuente": "request.reglas_negocio.contingencia_operativa", "valor_referencia": 0.0 },
      { "nombre": "cont_com", "tipo": "input", "fuente": "request.reglas_negocio.contingencia_comercial", "valor_referencia": 0.0 },
      { "nombre": "markup", "tipo": "input", "fuente": "request.reglas_negocio.markup", "valor_referencia": 0.0 },
      { "nombre": "descuento", "tipo": "input", "fuente": "request.reglas_negocio.descuento_volumen", "valor_referencia": 0.0 }
    ],
    "dependencias": ["costo_cadena_a"],
    "cadena": "A"
  },

